* text=auto eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf whitespace=-blank-at-eol
*.ps1 text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.nsi text eol=lf
*.manifest text eol=lf
*.desktop text eol=lf
*.sln text eol=crlf

*.png binary
*.ico binary
*.jpg binary
*.jpeg binary

# Upstream notices/assets have pinned byte hashes; preserve their original bytes.
third-party/** -text
# The upstream CC license deliberately ends with a blank line; retain pinned bytes.
third-party/simple-icons/CC-BY-SA-4.0.txt whitespace=-blank-at-eof
# Preserve the exact upstream Bitwarden notice, including its trademark-line space.
third-party/bitwarden/LICENSE.txt whitespace=-blank-at-eol
src/ServerDesk.App/Assets/** -text
tests/ServerDesk.Tests/Fixtures/** -text
